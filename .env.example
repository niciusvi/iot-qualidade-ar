# Copie para .env e ajuste os valores (o .env NUNCA vai para o git)

# --- Banco de dados ---
DB_PASSWORD=troque-esta-senha
DB_NAME=iaq
DB_USER=iaq
RETENCAO_DIAS=90

# --- Portas publicadas no host ---
BACKEND_PORT=3000
FRONTEND_PORT=8080
EVOLUTION_PORT=8081

# --- WhatsApp / Evolution API (Fase 2) ---
# Chave de autenticação da SUA instância Evolution (invente uma senha forte)
EVOLUTION_API_KEY=troque-esta-chave
# Nome da instância WhatsApp (criada no Manager: http://localhost:8081/manager)
EVOLUTION_INSTANCE=escola
# Destinatários iniciais dos alertas, separados por vírgula.
# Número individual: 5511999999999 · Grupo: 120363xxxxxxxxxxx@g.us
# (a partir da Fase 3 o cadastro será feito pelo portal)
ALERTA_NUMEROS=
# URL pública do dashboard, incluída no final das mensagens de alerta (opcional)
DASHBOARD_URL=
