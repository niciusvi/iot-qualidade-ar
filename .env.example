# Copie para .env e ajuste os valores (o .env NUNCA vai para o git)

# --- Banco de dados ---
DB_PASSWORD=troque-esta-senha
DB_NAME=iaq
DB_USER=iaq
RETENCAO_DIAS=90

# --- Portas publicadas no host ---
BACKEND_PORT=3000
FRONTEND_PORT=8080
EVOLUTION_PORT=8081

# --- WhatsApp / Evolution API (Fase 2) ---
# Chave de autenticação da SUA instância Evolution (invente uma senha forte)
EVOLUTION_API_KEY=troque-esta-chave
# Nome da instância WhatsApp (criada no Manager: http://localhost:8081/manager)
EVOLUTION_INSTANCE=escola
# Destinatários iniciais dos alertas, separados por vírgula.
# Número individual: 5511999999999 · Grupo: 120363xxxxxxxxxxx@g.us
# (a partir da Fase 3 o cadastro será feito pelo portal)
ALERTA_NUMEROS=
# URL pública do dashboard, incluída no final das mensagens de alerta (opcional)
DASHBOARD_URL=

# --- Portal / autenticação (Fase 3) ---
# Segredo dos tokens de sessão JWT (invente uma string longa e aleatória)
JWT_SECRET=troque-este-segredo
# Credenciais do administrador criado na primeira inicialização
ADMIN_USUARIO=admin
ADMIN_SENHA=troque-esta-senha
# URL pública do backend, gravada nos arquivos de provisionamento do ESP32
# (ex.: https://api.seu-dominio.com)
PUBLIC_BACKEND_URL=

# --- Cloudflare Access (opcional, recomendado quando a API fica pública) ---
# Service Token criado em Zero Trust > Access > Service Auth.
# Os valores entram no arquivo de provisionamento e o ESP32 passa a enviar
# os headers CF-Access-Client-Id / CF-Access-Client-Secret em cada requisição.
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# --- Modo desenvolvimento (opcional) ---
# Webhook do n8n que entrega os alertas pela Evolution já existente do ambiente.
# Definida = envios saem pelo gateway n8n (não precisa subir evolution/redis).
# Vazia (produção) = envios saem pela Evolution da própria stack.
N8N_WEBHOOK_URL=
